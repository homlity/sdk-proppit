# Proppit Real-Time API — SDK Configuration
# Spec: https://real-time.proppit.com/api/v2/docs/openapi.yaml

# ── Auth ──────────────────────────────────────────────────────────────────────
# System-level credentials provided by Proppit to identify Homlity as an API
# client. These are NOT per-agency credentials — they belong to the integration.
# Used by POST /token to obtain a Bearer token.
PROPPIT_BASE_URL=https://real-time.proppit.com/api/v2
PROPPIT_CLIENT_ID=
PROPPIT_CLIENT_SECRET=

# ── Publisher / Country ───────────────────────────────────────────────────────
# Country code for path param: /proppit/{country}/publishers and /ads
# Valid values: AE AR CL CO EC ES ID MX PA PE PH TH VN
PROPPIT_COUNTRY=CO

# Default publisher externalId for find()/delete() of ads.
# Leave empty in multi-agency installs and use findByExternalId() instead.
PROPPIT_PUBLISHER_EXTERNAL_ID=

# ── HTTP / Transport ──────────────────────────────────────────────────────────
PROPPIT_TIMEOUT=30
PROPPIT_RETRY_ATTEMPTS=3
PROPPIT_RETRY_DELAY_MS=500
PROPPIT_USER_AGENT="Homlity-Proppit-SDK/1.0"

# ── Logging ───────────────────────────────────────────────────────────────────
# Set to true to enable structured request/response logs via PSR-3 logger.
# Sensitive fields (Authorization, client_secret, tokens) are always redacted.
PROPPIT_ENABLE_STRUCTURED_LOGS=true

# ── Tests ─────────────────────────────────────────────────────────────────────
# Set to true only in CI environments with real credentials configured above.
# Unit tests never read this variable — it applies only to live integration tests.
PROPPIT_RUN_LIVE_TESTS=false

# ── Legacy aliases (deprecated — use CLIENT_ID/CLIENT_SECRET above) ──────────
# PROPPIT_API_KEY=
# PROPPIT_API_SECRET=
# PROPPIT_API_USER=
# PROPPIT_API_PASSWORD=
