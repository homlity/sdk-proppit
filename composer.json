{
  "name": "homlity/sdk-proppit",
  "description": "Proppit SDK for PHP/Laravel",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.8",
    "psr/log": "^2.0|^3.0",
    "illuminate/support": "^9.0|^10.0|^11.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "illuminate/container": "^9.0|^10.0|^11.0",
    "illuminate/config": "^9.0|^10.0|^11.0",
    "phpoption/phpoption": "^1.9",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "Propit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Propit\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Propit\\Laravel\\PropitServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
